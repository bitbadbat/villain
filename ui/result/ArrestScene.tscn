[sub_resource type="Shader" id="Shader_edgefade"]
code = "shader_type canvas_item;

// 경찰서 그림 양옆 나무가 그림 끝에서 칼같이 잘려 보이지 않게, 좌우 끝을 투명하게 녹인다.
// region이 그림 가로 전체라 UV.x가 곧 그림 가로 위치다
uniform float fade_left = 0.07;
uniform float fade_right = 0.07;

void fragment() {
	vec4 c = texture(TEXTURE, UV) * COLOR;
	c.a *= smoothstep(0.0, max(fade_left, 0.0001), UV.x) * smoothstep(1.0, 1.0 - max(fade_right, 0.0001), UV.x);
	COLOR = c;
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_edgefade"]
