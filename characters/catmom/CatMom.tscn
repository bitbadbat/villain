[node name="SkillUltimate" type="Node" parent="."]
script = ExtResource("9")
cooldown = 22.0
skill_name = "고양이 대작전"
description = "고른 고양이에 따라 다르다. 검은 고양이: 겨드랑이에 끼고 기본공격으로 똥 유탄 5발(범위 피해). 주황 고양이: 라운드 끝까지 고양이 옷을 입고 스킬을 못 쓰는 대신 기본공격이 세지고 빨라지며(3타는 머리를 잡아 등 뒤로 패대기), 대시가 빨리 돌고 받는 피해가 줄어든다. 흰 고양이: 그 자리에서 최대 체력의 30%를 회복한다"
start_on_cooldown = true
